# Beatbox Mic - Environment Variables
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/beatboxmic"

# =============================================================================
# NEXTAUTH AUTHENTICATION
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-random-64-char-string-here"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

FACEBOOK_CLIENT_ID="your-facebook-client-id"
FACEBOOK_CLIENT_SECRET="your-facebook-client-secret"

# =============================================================================
# FILE STORAGE (AWS S3 or Cloudflare R2)
# =============================================================================
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="beatbox-mic-audio"
AWS_REGION="us-east-1"

# Or use Cloudflare R2 (S3-compatible)
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key"
# R2_SECRET_ACCESS_KEY="your-r2-secret-key"
# R2_BUCKET_NAME="beatbox-mic-audio"

# =============================================================================
# STRIPE PAYMENTS
# =============================================================================
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# Price IDs
STRIPE_PREMIUM_PRICE_ID="price_premium_monthly"
STRIPE_PRO_PRICE_ID="price_pro_monthly"

# =============================================================================
# EMAIL (SendGrid or Resend)
# =============================================================================
SENDGRID_API_KEY="SG.your-sendgrid-api-key"
EMAIL_FROM="noreply@beatboxmic.com"

# Or use Resend
# RESEND_API_KEY="re_your-resend-api-key"

# =============================================================================
# AUDIO PROCESSING SETTINGS
# =============================================================================
NEXT_PUBLIC_MAX_AUDIO_FILE_SIZE=52428800  # 50MB in bytes
NEXT_PUBLIC_SUPPORTED_AUDIO_FORMATS=mp3,wav,ogg,m4a
NEXT_PUBLIC_MIN_AUDIO_DURATION=2000  # milliseconds
NEXT_PUBLIC_MAX_AUDIO_DURATION=300000  # 5 minutes
AUDIO_SAMPLE_RATE=44100
FFT_SIZE=4096
BUFFER_SIZE=256
MAX_LATENCY_MS=20

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
SENTRY_DSN="your-sentry-dsn"
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="beatboxmic.com"

# =============================================================================
# SECURITY
# =============================================================================
ENCRYPTION_KEY="generate-random-32-byte-hex-string"
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes

# =============================================================================
# PUBLIC ENVIRONMENT VARIABLES (accessible in browser)
# =============================================================================
NEXT_PUBLIC_APP_NAME="Beatbox Mic"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
